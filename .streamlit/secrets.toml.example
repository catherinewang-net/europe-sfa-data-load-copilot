# Copy to `.streamlit/secrets.toml` for local hosted testing only.
# Never commit secrets.toml — it is listed in .gitignore.
#
# Streamlit Community Cloud: paste equivalent TOML into App settings → Secrets.
# Top-level keys become environment variables (e.g. SALESFORCE_CLIENT_ID).

# ---------------------------------------------------------------------------
# Deployment (Streamlit Community Cloud — Advanced settings → Secrets)
# ---------------------------------------------------------------------------
DEPLOYMENT_MODE = "demo"
METADATA_MODE = "bundled"
# SSO_DISABLED = "true"

# ---------------------------------------------------------------------------
# Salesforce OAuth (optional — enables live org metadata when both are set)
# ---------------------------------------------------------------------------
# Register callback URL in Salesforce Connected App exactly as redirect URI below.
# Streamlit Cloud callback: https://<your-app-name>.streamlit.app/
SALESFORCE_CLIENT_ID = ""
SALESFORCE_REDIRECT_URI = "https://<your-app-name>.streamlit.app/"
SALESFORCE_API_VERSION = "v59.0"
# SALESFORCE_OAUTH_SCOPES = "api refresh_token id"

# ---------------------------------------------------------------------------
# Optional Entra OIDC app gate (separate from Salesforce OAuth)
# ---------------------------------------------------------------------------
# Only required when DEPLOYMENT_MODE=demo|production and SSO_DISABLED is unset.
# https://docs.streamlit.io/develop/concepts/connections/authentication

# [auth]
# redirect_uri = "https://<your-app-name>.streamlit.app/oauth2callback"
# cookie_secret = "<generate-a-long-random-string>"
# client_id = "<entra-app-registration-client-id>"
# client_secret = "<entra-app-registration-client-secret>"
# server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
