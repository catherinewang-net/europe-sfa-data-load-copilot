# Python / local dev
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — never copy into image
.env
.env.*
!.env.example
.streamlit/secrets.toml

# IDE / OS
.git/
.gitignore
.idea/
.vscode/
Thumbs.db
.DS_Store

# Docs and presentation assets not needed at runtime
docs/presentation/

# Test fixtures (optional — include demo CSV in leadership container)
# test_data/

# Keep bundled_metadata in the image (generated before docker build)
!bundled_metadata/
!bundled_metadata/**
