# Copy this file to `.env` in the project root and fill in values for your machine.
# Never commit `.env` — it may contain Salesforce credentials.

# -----------------------------------------------------------------------------
# Deployment mode
# -----------------------------------------------------------------------------
# local   — developer workstation (default)
# demo    — leadership demo on Azure Container Apps (Entra SSO required)
# production — future hosted production
DEPLOYMENT_MODE=local

# -----------------------------------------------------------------------------
# Metadata source
# -----------------------------------------------------------------------------
# local   — read from EUSFA_SFDX_REPO_PATH git clone (developer default)
# bundled — read from bundled_metadata/ snapshot (Docker / Streamlit Cloud default)
METADATA_MODE=local

# Absolute path to bundled snapshot (Docker sets /app/bundled_metadata automatically)
# BUNDLED_METADATA_PATH=

# Required for METADATA_MODE=local (optional on DEPLOYMENT_MODE=local — uses dev default)
# Absolute path to EUROPE_SFA SFDX repository root (must contain sfdx-project.json)
EUSFA_SFDX_REPO_PATH=

# Developer default when unset: %USERPROFILE%\.cursor\EUSFA SF\EUROPE_SFA

# -----------------------------------------------------------------------------
# Salesforce OAuth (primary — live org metadata)
# -----------------------------------------------------------------------------
# External Client App / Connected App with Authorization Code + PKCE (no secret).
# Register the callback URL exactly as SALESFORCE_REDIRECT_URI.

SALESFORCE_CLIENT_ID=
SALESFORCE_REDIRECT_URI=
SALESFORCE_API_VERSION=v59.0
# Space-separated OAuth scopes (default: api refresh_token id)
# SALESFORCE_OAUTH_SCOPES=api refresh_token id

# -----------------------------------------------------------------------------
# Authentication (optional Entra app gate — not primary Salesforce auth)
# -----------------------------------------------------------------------------
# Set SSO_DISABLED=true to bypass st.login() during local Streamlit dev
# SSO_DISABLED=true

# Force SSO on local machine (mirrors demo auth flow)
# SSO_ENABLED=true

# Entra OIDC values belong in .streamlit/secrets.toml — see secrets.toml.example
# Entra SSO is an optional app-level gate only; it does not replace Salesforce OAuth.

# -----------------------------------------------------------------------------
# Legacy env-based Salesforce lookup (deprecated — use OAuth connection)
# -----------------------------------------------------------------------------
# Phase 1 validation uses local/bundled metadata when OAuth is not connected.
# Live lookup for "Salesforce Record Check" may still use these when set:

# SF_INSTANCE_URL=https://your-instance.my.salesforce.com
# SF_ACCESS_TOKEN=

# SF_USERNAME=
# SF_PASSWORD=
# SF_SECURITY_TOKEN=
# SF_DOMAIN=login
# SF_CLIENT_ID=
# SF_CLIENT_SECRET=
